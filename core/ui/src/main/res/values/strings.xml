    <string name="about_secret_vault">About Secret Vault</string>
    <string name="about_page_title">Secret Vault</string>
    <string name="about_page_description">"\nSecret Vault securely stores your private information using industry-standard encryption. Your secrets remain encrypted at all times and can only be viewed after biometric authentication.\n                "</string>
    <string name="how_data_is_protected">How your data is protected</string>
    <string name="about_page_b1">AES encryption is used to securely protect all stored secrets.</string>
    <string name="about_page_b2">Encrypted data is stored locally using Room database.</string>
    <string name="about_page_b3">Your decryption key is stored inside AndroidKeyStore hardware, the most secure place on your device.</string>
    <string name="about_page_b4">Only your biometric authentication can unlock your secret information.</string>
    <string name="privacy_first">Privacy first</string>
    <string name="privacy_b1">By default, your secrets never leave your device.</string>
    <string name="privacy_b2">Cloud backup is entirely opt-in, and end-to-end encrypted before it ever leaves your device.</string>
    <string name="privacy_b3">Even after authentication, your decrypted data is never stored, logged, or shared by Secret Vault.</string>
    <string name="privacy_b4">You control what you store and when you delete it.</string>
    <string name="privacy_b5">Backups are encrypted with Argon2id and AES-256-GCM using a key only you hold - Google never sees your secrets, and we can\'t either.</string>
    <string name="privacy_b6">If you lose your backup key, that cloud backup can never be recovered by anyone, including us - there is no recovery option.</string>
